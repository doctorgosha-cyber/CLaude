[{"filePath":"/home/user/CLaude/trials-cloud-2/fixtures/04-html-validate/seeded/H1-review-dup-id.html","messages":[{"ruleId":"no-dup-id","severity":2,"message":"Duplicate ID \"verdict\"","offset":1831,"line":53,"column":12,"size":7,"selector":"html > body > main > article > aside","ruleUrl":"https://html-validate.org/rules/no-dup-id.html","related":[{"kind":"element","selector":"html > body > main > article > section:nth-child(4)"}]}],"errorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Orijen Original Dry Dog Food review (2026)</title>\n<link rel=\"stylesheet\" href=\"/assets/review.css\">\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"Review\",\"itemReviewed\":{\"@type\":\"Product\",\"name\":\"Orijen Original\"},\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"4.5\",\"bestRating\":\"5\"},\"author\":{\"@type\":\"Person\",\"name\":\"NEXUS Pet Lab\"}}\n</script>\n</head>\n<body>\n<header class=\"site-header\">\n<nav aria-label=\"Main\">\n<ul>\n<li><a href=\"/\">Home</a></li>\n<li><a href=\"/dog-food/\">Dog food</a></li>\n<li><a href=\"/calculator/\">Feeding calculator</a></li>\n</ul>\n</nav>\n</header>\n<main>\n<article>\n<h1>Orijen Original Dry Dog Food review</h1>\n<p class=\"byline\">By <a href=\"/about/\">NEXUS Pet Lab</a> · Updated <time datetime=\"2026-10-12\">12 October 2026</time></p>\n<nav aria-label=\"On this page\">\n<ol>\n<li><a href=\"#verdict\">Verdict</a></li>\n<li><a href=\"#ingredients\">Ingredients</a></li>\n<li><a href=\"#price\">Price per day</a></li>\n</ol>\n</nav>\n<section id=\"verdict\">\n<h2>Verdict</h2>\n<p>A high-protein kibble with 85% animal ingredients. Expensive, but our test dogs ate it enthusiastically.</p>\n</section>\n<section id=\"ingredients\">\n<h2>Ingredients</h2>\n<table>\n<caption>Guaranteed analysis</caption>\n<thead><tr><th scope=\"col\">Nutrient</th><th scope=\"col\">Minimum</th></tr></thead>\n<tbody>\n<tr><td>Crude protein</td><td>38%</td></tr>\n<tr><td>Crude fat</td><td>18%</td></tr>\n<tr><td>Crude fibre</td><td>4%</td></tr>\n</tbody>\n</table>\n</section>\n<section id=\"price\">\n<h2>Price per day</h2>\n<p>For a 20 kg adult dog at moderate activity, expect about 230 g per day, or roughly <strong>2.10 EUR/day</strong> at the current 11.4 kg bag price.</p>\n</section>\n<aside id=\"verdict\" class=\"verdict-box\">\n<h2>Our rating</h2>\n<p><strong>4.5 / 5</strong> – recommended for active adult dogs.</p>\n</aside>\n</article>\n</main>\n<footer>\n<p>&copy; 2026 NEXUS Pet Lab. Prices checked monthly.</p>\n</footer>\n</body>\n</html>\n"},{"filePath":"/home/user/CLaude/trials-cloud-2/fixtures/04-html-validate/seeded/H2-cards-nested-anchor.html","messages":[{"ruleId":"element-permitted-content","severity":2,"message":"<a> element is not permitted as a descendant of <a>","offset":673,"line":19,"column":2,"size":1,"selector":"html > body > main > ul > li:nth-child(1) > a > a","ruleUrl":"https://html-validate.org/rules/element-permitted-content.html","context":{"kind":"descendant","ancestor":"<a>","child":"<a>"},"related":[]}],"errorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Best wet cat foods 2026 – our picks</title>\n<link rel=\"stylesheet\" href=\"/assets/cards.css\">\n</head>\n<body>\n<main>\n<h1>Best wet cat foods 2026</h1>\n<p>Tested over 8 weeks with 12 cats. Prices are per 100 g and updated weekly.</p>\n<ul class=\"card-grid\">\n<li class=\"card\">\n<a href=\"/cat-food/sheba-fresh-fine/\" class=\"card-link\">\n<img src=\"/img/sheba-fresh-fine.webp\" alt=\"Sheba Fresh &amp; Fine pouches, chicken flavour\" width=\"320\" height=\"240\" loading=\"lazy\">\n<h2>Sheba Fresh &amp; Fine</h2>\n<p>Best value. Low grain, 85% meat.</p>\n<a href=\"/go/sheba/\" rel=\"sponsored\">Check price</a>\n</a>\n</li>\n<li class=\"card\">\n<a href=\"/cat-food/applaws-tuna/\" class=\"card-link\">\n<img src=\"/img/applaws-tuna.webp\" alt=\"Applaws tuna fillet tin\" width=\"320\" height=\"240\" loading=\"lazy\">\n<h2>Applaws Tuna Fillet</h2>\n<p>Complementary food, not a complete diet.</p>\n</a>\n<p class=\"price\">0.89 EUR / 100 g</p>\n</li>\n<li class=\"card\">\n<a href=\"/cat-food/animonda-carny/\" class=\"card-link\">\n<img src=\"/img/animonda-carny.webp\" alt=\"Animonda Carny beef tin\" width=\"320\" height=\"240\" loading=\"lazy\">\n<h2>Animonda Carny Adult</h2>\n<p>Complete food, no sugar, no grain.</p>\n</a>\n<p class=\"price\">0.52 EUR / 100 g</p>\n</li>\n</ul>\n</main>\n<footer><p>Affiliate links are marked with \"Check price\".</p></footer>\n</body>\n</html>\n"},{"filePath":"/home/user/CLaude/trials-cloud-2/fixtures/04-html-validate/seeded/H3-figure-hidden-img-noalt.html","messages":[{"ruleId":"element-required-attributes","severity":2,"message":"<img> is missing required \"alt\" attribute","offset":1501,"line":35,"column":2,"size":3,"selector":"#fallback > img","ruleUrl":"https://html-validate.org/rules/element-required-attributes.html","context":{"tagName":"<img>","attr":"alt"},"related":[]}],"errorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Figure 3 – Protein vs. price per kcal</title>\n<link rel=\"stylesheet\" href=\"/assets/figure.css\">\n</head>\n<body>\n<main>\n<h1>Figure 3: Protein content vs. price per 1000 kcal</h1>\n<figure>\n<canvas id=\"scatter\" width=\"800\" height=\"480\" role=\"img\" aria-label=\"Scatter plot of 42 dog foods: protein percentage on the x axis, price per 1000 kcal on the y axis\">Your browser does not support canvas.</canvas>\n<figcaption>Each dot is one product. Hover or focus a dot for details.</figcaption>\n</figure>\n<form class=\"controls\" aria-label=\"Figure controls\">\n<fieldset>\n<legend>Show</legend>\n<label><input type=\"checkbox\" name=\"type\" value=\"dry\" checked> Dry</label>\n<label><input type=\"checkbox\" name=\"type\" value=\"wet\" checked> Wet</label>\n</fieldset>\n<label for=\"minprotein\">Minimum protein (%)</label>\n<input type=\"range\" id=\"minprotein\" name=\"minprotein\" min=\"18\" max=\"45\" value=\"18\">\n<output for=\"minprotein\" id=\"minprotein-out\">18</output>\n<button type=\"button\" id=\"reset\">Reset</button>\n</form>\n<svg width=\"200\" height=\"40\" role=\"img\" aria-labelledby=\"legend-title\">\n<title id=\"legend-title\">Legend: blue dots are dry food, orange dots are wet food</title>\n<circle cx=\"12\" cy=\"20\" r=\"6\" fill=\"#2a6fdb\"></circle>\n<text x=\"24\" y=\"25\">Dry</text>\n<circle cx=\"92\" cy=\"20\" r=\"6\" fill=\"#e07b1a\"></circle>\n<text x=\"104\" y=\"25\">Wet</text>\n</svg>\n<div id=\"fallback\" hidden>\n<img src=\"/img/figure-3-static.png\" width=\"800\" height=\"480\">\n<p>Static fallback image, shown when JavaScript is disabled.</p>\n</div>\n</main>\n<script src=\"/assets/figure-3.js\" defer></script>\n</body>\n</html>\n"},{"filePath":"/home/user/CLaude/trials-cloud-2/fixtures/04-html-validate/seeded/H4-faq-stray-end-tag.html","messages":[{"ruleId":"close-order","severity":2,"message":"Stray end tag '</div>'","offset":914,"line":21,"column":2,"size":4,"selector":null,"ruleUrl":"https://html-validate.org/rules/close-order.html","related":[]}],"errorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Feeding calculator FAQ</title>\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"How much should I feed my dog?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It depends on weight, age and activity. Use the calculator.\"}}]}\n</script>\n</head>\n<body>\n<main>\n<h1>Feeding calculator FAQ</h1>\n<details open>\n<summary>How much should I feed my dog?</summary>\n<p>It depends on weight, age and activity. The calculator uses the NRC resting energy formula, <code>70 × kg<sup>0.75</sup></code>, and multiplies by an activity factor.</p>\n</details>\n<details>\n<summary>Why does the result differ from the bag label?</summary>\n<p>Bag labels are generic. They often overestimate for neutered or indoor dogs.</p>\n</div>\n</details>\n<details>\n<summary>Can I mix wet and dry food?</summary>\n<p>Yes. Enter both products and the calculator splits the daily kcal between them.</p>\n</details>\n<details>\n<summary>Is the catalogue complete?</summary>\n<p>No. We add products as we test them. <a href=\"/contact/\">Suggest a product</a>.</p>\n</details>\n</main>\n</body>\n</html>\n"},{"filePath":"/home/user/CLaude/trials-cloud-2/fixtures/04-html-validate/seeded/H5-form-label-missing-id.html","messages":[{"ruleId":"no-missing-references","severity":2,"message":"Element references missing id \"comments\"","offset":718,"line":25,"column":13,"size":8,"selector":"html > body > main > form > div:nth-child(4) > label","ruleUrl":"https://html-validate.org/rules/no-missing-references.html","context":{"key":"for","value":"comments"},"related":[]}],"errorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Suggest a product</title>\n</head>\n<body>\n<main>\n<h1>Suggest a product for testing</h1>\n<form action=\"/suggest/\" method=\"post\">\n<div class=\"field\">\n<label for=\"product\">Product name</label>\n<input type=\"text\" id=\"product\" name=\"product\" required autocomplete=\"off\">\n</div>\n<div class=\"field\">\n<label for=\"brand\">Brand</label>\n<input type=\"text\" id=\"brand\" name=\"brand\" autocomplete=\"organization\">\n</div>\n<div class=\"field\">\n<label for=\"email\">Your e-mail (optional)</label>\n<input type=\"email\" id=\"email\" name=\"email\" autocomplete=\"email\">\n</div>\n<div class=\"field\">\n<label for=\"comments\">Why should we test it?</label>\n<textarea id=\"comment\" name=\"comments\" rows=\"4\"></textarea>\n</div>\n<div class=\"field\">\n<label for=\"species\">Species</label>\n<select id=\"species\" name=\"species\">\n<option value=\"dog\">Dog</option>\n<option value=\"cat\">Cat</option>\n</select>\n</div>\n<button type=\"submit\">Send suggestion</button>\n</form>\n</main>\n</body>\n</html>\n"},{"filePath":"/home/user/CLaude/trials-cloud-2/fixtures/04-html-validate/seeded/H6-table-deprecated-attr.html","messages":[{"ruleId":"no-deprecated-attr","severity":2,"message":"Attribute \"cellpadding\" is deprecated on <table> element","offset":363,"line":13,"column":8,"size":11,"selector":"html > body > main > table","ruleUrl":"https://html-validate.org/rules/no-deprecated-attr.html","related":[]}],"errorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Dry dog food comparison table</title>\n<link rel=\"stylesheet\" href=\"/assets/table.css\">\n</head>\n<body>\n<main>\n<h1>Dry dog food comparison</h1>\n<p>Sorted by protein. Prices per kg from our October 2026 price check.</p>\n<table cellpadding=\"4\" class=\"compare\">\n<caption>12 dry dog foods compared</caption>\n<thead>\n<tr><th scope=\"col\">Product</th><th scope=\"col\">Protein</th><th scope=\"col\">Fat</th><th scope=\"col\">Price / kg</th><th scope=\"col\">Rating</th></tr>\n</thead>\n<tbody>\n<tr><td>Orijen Original</td><td>38%</td><td>18%</td><td>9.10 EUR</td><td>4.5</td></tr>\n<tr><td>Acana Wild Prairie</td><td>33%</td><td>17%</td><td>7.40 EUR</td><td>4.3</td></tr>\n<tr><td>Wolfsblut Wild Duck</td><td>26%</td><td>14%</td><td>6.20 EUR</td><td>4.0</td></tr>\n<tr><td>Josera Optiness</td><td>22%</td><td>12%</td><td>3.90 EUR</td><td>3.8</td></tr>\n</tbody>\n</table>\n</main>\n</body>\n</html>\n"}]